extends ../layout

block contenido
  a.volver(href="/organizaciones") ← Volver al listado de organizaciones

  .encabezado-seccion
    h1= organizacion.nombre
    .acciones
      if ["administrador", "trabajo_social"].includes(usuarioActual.rol)
        a.boton(href=`/organizaciones/${organizacion._id}/editar`) Editar
      if usuarioActual.rol === "administrador"
        form.form-inline(action=`/organizaciones/${organizacion._id}?_method=DELETE` method="POST" onsubmit="return confirm('¿Eliminar esta organización?');")
          button.boton.boton-peligro(type="submit") Eliminar

  .ficha
    p= organizacion.descripcion

  .encabezado-seccion
    h2 Proyectos de esta organización
    if ["administrador", "mesa_coordinadora", "trabajo_social"].includes(usuarioActual.rol)
      a.boton.boton-primario(href="/proyectos/nuevo") + Nuevo proyecto
  if proyectos.length === 0
    p.vacio Esta organización todavía no tiene proyectos cargados.
  else
    table.tabla
      thead
        tr
          th Proyecto
          th Monto objetivo
          th Saldo disponible
          th
      tbody
        each proyecto in proyectos
          tr
            td= proyecto.nombre
            td= proyecto.montoObjetivo ? ("$" + proyecto.montoObjetivo.toLocaleString("es-AR")) : "—"
            td.saldo= "$" + proyecto.saldoDisponible.toLocaleString("es-AR")
            td
              a.boton(href=`/proyectos/${proyecto._id}`) Ver detalle
