extends ../layout

block contenido
  a.volver(href="/") ← Volver al listado de proyectos

  .encabezado-seccion
    h1= proyecto.nombre
    .acciones
      if puede("GESTION_PROYECTOS")
        a.boton(href=`/proyectos/${proyecto._id}/editar`) Editar
        form.form-inline(action=`/proyectos/${proyecto._id}/estado` method="POST")
          input(type="hidden" name="activo" value=proyecto.activo === false ? "true" : "false")
          button.boton(type="submit")= proyecto.activo === false ? "Activar" : "Desactivar"
      if puede("BAJA_PROYECTOS")
        form.form-inline(action=`/proyectos/${proyecto._id}?_method=DELETE` method="POST" data-confirm="¿Eliminar este proyecto?")
          button.boton.boton-peligro(type="submit") Eliminar

  if proyecto.activo === false
    p.mensaje-error(role="status") Este proyecto está inactivo: no recibe donaciones ni rendiciones, pero conserva su historial.

  p.organizacion Organización responsable: #{organizacion ? organizacion.nombre : "No encontrada"}

  section.resumen
    div.tarjeta
      span.etiqueta Total donado
      span.valor= "$" + totalDonado.toLocaleString("es-AR")
    div.tarjeta
      span.etiqueta Total gastado aprobado
      span.valor= "$" + totalGastado.toLocaleString("es-AR")
    div.tarjeta
      span.etiqueta Total comprometido (incluye pendientes)
      span.valor= "$" + totalComprometido.toLocaleString("es-AR")
    div.tarjeta.destacada
      span.etiqueta Saldo disponible
      span.valor= "$" + saldoDisponible.toLocaleString("es-AR")

  if puede("LECTURA_FINANCIERA")
    .encabezado-seccion
      h2 Donaciones recibidas
      if puede("GESTION_FINANCIERA")
        a.boton.boton-primario(href=`/donaciones/nueva?proyectoId=${proyecto._id}`) + Nueva donación
    if donaciones.length === 0
      p.vacio Este proyecto todavía no recibió donaciones.
    else
      table.tabla
        thead
          tr
            th Donante
            th Monto
            th Fecha
            th
        tbody
          each donacion in donaciones
            tr
              td= donacion.donanteNombre
              td= "$" + donacion.monto.toLocaleString("es-AR")
              td= new Date(donacion.fecha).toLocaleDateString("es-AR")
              td
                if gastos.length === 0 && puede("GESTION_FINANCIERA")
                  a.boton.boton-chico(href=`/donaciones/${donacion._id}/editar`) Editar
                if gastos.length === 0 && puede("BAJA_REGISTROS")
                  form.form-inline(action=`/donaciones/${donacion._id}?_method=DELETE` method="POST" data-confirm="¿Eliminar esta donación?")
                    button.boton.boton-chico.boton-peligro(type="submit") Eliminar
  
  if usuarioActual.rol !== "trabajo_social"
    .encabezado-seccion
      h2 Gastos registrados
      if puede("CARGA_RENDICIONES")
        a.boton.boton-primario(href=`/gastos/nuevo?proyectoId=${proyecto._id}`) + Nuevo gasto
    if gastos.length === 0
      p.vacio Este proyecto todavía no registró gastos.
    else
      table.tabla
        thead
          tr
            th Descripción
            th Monto
            th Fecha
            th Rubro
            th Estado
            th Comprobante
        tbody
          each gasto in gastos
            tr
              td= gasto.descripcion
              td= "$" + gasto.monto.toLocaleString("es-AR")
              td= new Date(gasto.fecha).toLocaleDateString("es-AR")
              td= gasto.rubro
              td= gasto.estado || "Registro anterior"
              td
                if gasto.comprobante
                  a(href=`/rendiciones/${gasto._id}/comprobante` target="_blank" rel="noopener") Ver archivo
                else
                  span No digitalizado
