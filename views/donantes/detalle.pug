extends ../layout

block contenido
  a.volver(href="/donantes") ← Volver al listado de donantes

  .encabezado-seccion
    h1= donante.nombre
    .acciones
      if puede("GESTION_FINANCIERA")
        a.boton(href=`/donantes/${donante._id}/editar`) Editar
      if puede("BAJA_REGISTROS")
        form.form-inline(action=`/donantes/${donante._id}?_method=DELETE` method="POST" data-confirm="¿Eliminar este donante?")
          button.boton.boton-peligro(type="submit") Eliminar

  .ficha
    span.etiqueta Tipo de donante
    span.valor-grande= donante.tipo === "corporativo" ? "Corporativo" : "Individual"
    p Email: #{donante.email}
    p Total donado: #[strong= "$" + totalDonado.toLocaleString("es-AR")]

  .encabezado-seccion
    h2 Historial de donaciones
    if puede("GESTION_FINANCIERA")
      a.boton.boton-primario(href=`/donaciones/nueva`) + Nueva donación
  if donaciones.length === 0
    p.vacio Este donante todavía no registró donaciones.
  else
    table.tabla
      thead
        tr
          th Proyecto
          th Monto
          th Fecha
      tbody
        each donacion in donaciones
          tr
            td= donacion.proyectoNombre
            td= "$" + donacion.monto.toLocaleString("es-AR")
            td= new Date(donacion.fecha).toLocaleDateString("es-AR")
