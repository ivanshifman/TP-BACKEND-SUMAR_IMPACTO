extends ../layout

block contenido
  .encabezado-seccion
    h1 Organizaciones
    a.boton.boton-primario(href="/organizaciones/nuevo") + Nueva organización

  if organizaciones.length === 0
    p.vacio No hay organizaciones cargadas todavía.
  else
    table.tabla
      thead
        tr
          th Nombre
          th Descripción
          th Proyectos
          th
      tbody
        each organizacion in organizaciones
          tr
            td= organizacion.nombre
            td= organizacion.descripcion
            td= organizacion.cantidadProyectos
            td
              a.boton(href=`/organizaciones/${organizacion._id}`) Ver detalle
