extends ../layout

block contenido
  .encabezado-seccion
    h1 Donantes
    a.boton.boton-primario(href="/donantes/nuevo") + Nuevo donante

  if donantes.length === 0
    p.vacio No hay donantes cargados todavía.
  else
    table.tabla
      thead
        tr
          th Nombre
          th Tipo
          th Email
          th Cantidad de donaciones
          th Total donado
          th
      tbody
        each donante in donantes
          tr
            td= donante.nombre
            td= donante.tipo === "corporativo" ? "Corporativo" : "Individual"
            td= donante.email
            td= donante.cantidadDonaciones
            td= "$" + donante.totalDonado.toLocaleString("es-AR")
            td
              a.boton(href=`/donantes/${donante._id}`) Ver detalle
