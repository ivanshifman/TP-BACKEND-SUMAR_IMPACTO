extends ../layout

block contenido
  h1 Nuevo gasto

  p.ayuda El sistema valida automáticamente que el monto no supere el saldo disponible del proyecto seleccionado.

  form.formulario(action="/gastos" method="POST" enctype="multipart/form-data")
    .campo
      label(for="proyecto") Proyecto
      select#proyecto(name="proyecto" required)
        option(value="") Seleccionar proyecto...
        each p in proyectos
          option(
            value=p._id
            selected=gasto.proyecto && String(gasto.proyecto) === String(p._id)
          )= p.nombre + " - saldo disponible: $" + p.saldoDisponible.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      if proyectos.length === 0
        small No hay proyectos activos con presupuesto, período y rubros válidos para cargar rendiciones.
      else
        small El saldo se vuelve a validar al registrar el gasto.

    .campo
      label(for="monto") Monto
      input#monto(type="number" name="monto" min="0.01" step="0.01" required)

    .campo
      label(for="fecha") Fecha del comprobante
      input#fecha(type="date" name="fecha" required)

    .campo
      label(for="rubro") Rubro presupuestado
      input#rubro(type="text" name="rubro" list="rubros-lista" required placeholder="Ej.: Alimentos")
      datalist#rubros-lista
        each p in proyectos
          each r in (p.rubros || [])
            option(value=r.nombre)
      small Si elegís “otro”, la rendición pasa a revisión de Auditoría.

    .campo
      label(for="descripcion") Descripción
      textarea#descripcion(name="descripcion" minlength="3" maxlength="500" rows="3" required)

    .campo
      label(for="comprobante") Comprobante (JPG, PNG, WEBP o PDF; máximo 5 MB)
      input#comprobante(type="file" name="comprobante" accept="image/jpeg,image/png,image/webp,application/pdf" required)

    .acciones-formulario
      button.boton.boton-primario(type="submit") Registrar gasto
      a.boton(href="/gastos") Cancelar
