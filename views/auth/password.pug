extends ../layout

block contenido
  h1 Mi contraseña
  if forzado
    p.mensaje-error(role="alert") Por seguridad, tenés que elegir una contraseña propia antes de continuar.
  else
    p.ayuda Elegí una contraseña nueva. Tu sesión actual se mantiene y las demás se cierran.
  form.formulario(action="/perfil/password" method="POST")
    .campo
      label(for="passwordActual") Contraseña actual
      input#passwordActual(type="password" name="passwordActual" required autocomplete="current-password")
    .campo
      label(for="passwordNueva") Contraseña nueva
      input#passwordNueva(type="password" name="passwordNueva" required minlength="12" maxlength="72" autocomplete="new-password")
      small Entre 12 y 72 caracteres, con mayúscula, minúscula, número y símbolo. Debe ser distinta de la actual.
    .campo
      label(for="confirmarPassword") Repetir contraseña nueva
      input#confirmarPassword(type="password" name="confirmarPassword" required minlength="12" maxlength="72" autocomplete="new-password")
    button.boton.boton-primario(type="submit") Cambiar contraseña
