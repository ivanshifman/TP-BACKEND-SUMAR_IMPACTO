# MongoDB Atlas o instancia local
MONGODB_URI=mongodb://127.0.0.1:27017/sumarimpacto
PORT=3000
# En producción usá NODE_ENV=production: activa cookies Secure, HSTS y la CSP completa.
NODE_ENV=development

# Generá dos secretos independientes de al menos 32 caracteres.
# Ejemplo: openssl rand -base64 48
JWT_ACCESS_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
JWT_REFRESH_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DISTINTO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=sumarimpacto-api
JWT_AUDIENCE=sumarimpacto-client

# Primer administrador (usado por npm run create-admin)
BOOTSTRAP_ADMIN_NAME=Administrador SumarImpacto
BOOTSTRAP_ADMIN_EMAIL=admin@sumarimpacto.local
# Entre 12 y 72 caracteres, con mayúscula, minúscula, número y símbolo.
# El administrador deberá cambiarla en su primer ingreso.
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_SEGURA_DE_12_CARACTERES

# Solo si el hosting está detrás de un proxy confiable
TRUST_PROXY=false

# Orígenes exactos del frontend separados por coma (Vercel, localhost, etc.)
CORS_ORIGINS=http://localhost:3000

# Umbrales de aprobación (porcentajes configurables; confirmar con Mesa Coordinadora)
RENDICION_AUTO_MAX_PCT=5
RENDICION_MESA_MIN_PCT=30
RENDICION_AUTO_MONTHLY_CAP_PCT=5
