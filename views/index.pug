extends layout

block contenido
  .encabezado-seccion
    h1= verInactivos ? "Todos los proyectos" : "Proyectos activos"
    if puede("GESTION_PROYECTOS")
      .acciones
        a.boton(href=verInactivos ? "/" : "/?inactivos=1")= verInactivos ? "Ocultar inactivos" : "Ver inactivos"
        a.boton.boton-primario(href="/proyectos/nuevo") + Nuevo proyecto

  if proyectos.length === 0
    p.vacio No hay proyectos cargados todavía.
  else
    table.tabla
      thead
        tr
          th Proyecto
          th Organización
          th Total donado
          th Total gastado
          th Comprometido
          th Saldo disponible
          th
      tbody
        each proyecto in proyectos
          tr
            td
              = proyecto.nombre
              if proyecto.activo === false
                span.insignia Inactivo
            td= proyecto.organizacionNombre
            td= "$" + proyecto.totalDonado.toLocaleString("es-AR")
            td= "$" + proyecto.totalGastado.toLocaleString("es-AR")
            td= "$" + proyecto.totalComprometido.toLocaleString("es-AR")
            td.saldo= "$" + proyecto.saldoDisponible.toLocaleString("es-AR")
            td
              a.boton(href=`/proyectos/${proyecto._id}`) Ver detalle
