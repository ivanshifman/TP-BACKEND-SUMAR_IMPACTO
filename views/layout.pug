doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo || "SumarImpacto"
    link(rel="stylesheet" href="/css/styles.css")
  body
    header.encabezado
      a.logo(href="/") SumarImpacto
      p.tagline Trazabilidad y gestión de donaciones para proyectos sociales
      nav.nav
        a(href="/") Proyectos
        if usuarioActual && ["administrador", "administracion", "auditoria", "mesa_coordinadora"].includes(usuarioActual.rol)
          a(href="/donantes") Donantes
        if usuarioActual && ["administrador", "trabajo_social", "mesa_coordinadora", "auditoria", "administracion"].includes(usuarioActual.rol)
          a(href="/organizaciones") Organizaciones
        if usuarioActual && ["administrador", "referente_territorial", "auditoria", "mesa_coordinadora", "administracion"].includes(usuarioActual.rol)
          a(href="/gastos") Gastos
          a(href="/rendiciones") Rendiciones
        a(href="/tutorial") Ayuda
        if usuarioActual && usuarioActual.rol === "administrador"
          a(href="/admin") Administración
        if usuarioActual && ["administrador", "mesa_coordinadora", "administracion"].includes(usuarioActual.rol)
          a(href="/admin/campanias") Campañas
        if usuarioActual
          span.usuario-nav= usuarioActual.nombre
          form.form-inline(action="/logout" method="POST")
            button.boton.boton-chico(type="submit") Salir
    main.contenido
      block contenido
    footer.pie
      p Trabajo Práctico Integrador — Desarrollo Web Backend — IFTS N° 29
